+.support-carousel {
+  --support-blue: #0040b0;
+  --sc-card-w: 300px;
+
+  display: grid;
+  grid-template-columns: auto 1fr auto;
+  align-items: center;
+  gap: var(--spacing-s);
+  max-width: var(--grid-container-width);
+  margin: var(--spacing-xl) auto;
+}
+
+.support-carousel .support-carousel-viewport {
+  overflow: hidden;
+}
+
+.support-carousel .support-carousel-track {
+  display: flex;
+  gap: var(--spacing-l);
+  overflow-x: auto;
+  scroll-snap-type: x mandatory;
+  scroll-behavior: smooth;
+  scrollbar-width: none;
+  padding-bottom: var(--spacing-xs);
+}
+
+.support-carousel .support-carousel-track::-webkit-scrollbar {
+  display: none;
+}
+
+.support-carousel .support-carousel-slide {
+  flex: 0 0 var(--sc-card-w);
+  scroll-snap-align: start;
+}
+
+.support-carousel .support-carousel-card {
+  display: flex;
+  flex-direction: column;
+  height: 100%;
+  background-color: light-dark(var(--color-light), var(--color-gray-900));
+  border: 1px solid light-dark(var(--color-gray-200), var(--color-gray-700));
+  border-radius: 12px;
+  overflow: hidden;
+  transition: box-shadow 0.2s ease-in-out, transform 0.2s ease-in-out;
+}
+
+.support-carousel .support-carousel-card:hover {
+  box-shadow: 0 4px 16px 0 rgb(0 0 0 / 12%);
+  transform: translateY(-2px);
+}
+
+.support-carousel .support-carousel-image {
+  aspect-ratio: 16 / 9;
+  overflow: hidden;
+  background-color: light-dark(var(--color-gray-100), var(--color-gray-800));
+}
+
+.support-carousel .support-carousel-image img,
+.support-carousel .support-carousel-image picture {
+  width: 100%;
+  height: 100%;
+  object-fit: cover;
+  display: block;
+}
+
+.support-carousel .support-carousel-title {
+  margin: 0;
+  padding: var(--spacing-l) var(--spacing-l) 0;
+  font-size: var(--heading-font-size-xs);
+  color: light-dark(var(--color-dark), var(--color-light));
+}
+
+.support-carousel .support-carousel-desc {
+  margin: var(--spacing-s) 0 0;
+  padding: 0 var(--spacing-l);
+  font-size: var(--body-font-size-s);
+  line-height: var(--body-line-height);
+  color: light-dark(var(--color-gray-700), var(--color-gray-300));
+}
+
+.support-carousel .support-carousel-cta {
+  margin-top: auto;
+  padding: var(--spacing-m) var(--spacing-l) var(--spacing-l);
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  color: var(--support-blue);
+  font-weight: 600;
+  text-decoration: none;
+}
+
+.support-carousel .support-carousel-cta:hover {
+  text-decoration: underline;
+}
+
+.support-carousel .support-carousel-card:hover .support-carousel-arrow {
+  transform: translateX(4px);
+}
+
+.support-carousel .support-carousel-arrow {
+  transition: transform 0.2s ease-in-out;
+}
+
+/* Prev/Next buttons */
+.support-carousel .support-carousel-btn {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  width: 44px;
+  height: 44px;
+  border: 1px solid light-dark(var(--color-gray-300), var(--color-gray-600));
+  border-radius: 50%;
+  background-color: light-dark(var(--color-light), var(--color-gray-800));
+  color: var(--support-blue);
+  font-size: 24px;
+  line-height: 1;
+  cursor: pointer;
+  transition: background-color 0.2s ease-in-out, opacity 0.2s ease-in-out;
+}
+
+.support-carousel .support-carousel-btn:hover:not(:disabled) {
+  background-color: light-dark(var(--color-gray-100), var(--color-gray-700));
+}
+
+.support-carousel .support-carousel-btn:disabled {
+  opacity: 0.35;
+  cursor: default;
+}
+
+/* Dots */
+.support-carousel .support-carousel-dots {
+  grid-column: 1 / -1;
+  display: flex;
+  justify-content: center;
+  gap: var(--spacing-s);
+  margin-top: var(--spacing-m);
+}
+
+.support-carousel .support-carousel-dot {
+  width: 10px;
+  height: 10px;
+  padding: 0;
+  border: 0;
+  border-radius: 50%;
+  background-color: light-dark(var(--color-gray-300), var(--color-gray-600));
+  cursor: pointer;
+  transition: background-color 0.2s ease-in-out;
+}
+
+.support-carousel .support-carousel-dot.is-active {
+  background-color: var(--support-blue);
+}
+
+@media (width >= 900px) {
+  .support-carousel {
+    --sc-card-w: calc((100% - 2 * var(--spacing-l)) / 3);
+  }
+}
+
+@media (width <= 600px) {
+  .support-carousel {
+    --sc-card-w: 82%;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .support-carousel * {
+    transition: none !important;
+    scroll-behavior: auto !important;
+  }
+}
diff --git a/blocks/support-carousel/support-carousel.js b/blocks/support-carousel/support-carousel.js
new file mode 100644
index 0000000..a8f9d70
--- /dev/null
+++ b/blocks/support-carousel/support-carousel.js
@@ -0,0 +1,133 @@
+/*
+ * Support Carousel block — SAP Support Portal (POC)
+ *
+ * Horizontal, accessible card carousel used for "Features" and "Additional
+ * resources" (mirrors the real support.sap.com carousels with Prev/Next).
+ * Scroll-snap track + Prev/Next buttons + dot indicators + keyboard support.
+ *
+ * Each authored row = one card in a cell with (any of):
+ *   - an image (<picture>/<img> or a bare image URL)
+ *   - a heading (title)
+ *   - paragraph(s) (description)
+ *   - a link (CTA)
+ *
+ * Lighthouse-friendly: images carry explicit width/height + lazy loading;
+ * the track reserves its height so there is no layout shift.
+ */
+
+const IMG_W = 600;
+const IMG_H = 338;
+
+function h(tag, attrs = {}, ...children) {
+  const node = document.createElement(tag);
+  for (const [key, value] of Object.entries(attrs)) {
+    if (value !== undefined && value !== null) {
+      if (key === 'class') node.className = value;
+      else if (key === 'text') node.textContent = value;
+      else node.setAttribute(key, value);
+    }
+  }
+  for (const child of children) if (child) node.append(child);
+  return node;
+}
+
+function decorateImage(inner) {
+  let img = inner.querySelector('img');
+  if (!img) {
+    const imgLink = [...inner.querySelectorAll('a')].find((a) => /\.(jpe?g|png|webp|svg|gif)(\?|$)/i.test(a.getAttribute('href') || ''));
+    if (imgLink) {
+      img = document.createElement('img');
+      img.src = imgLink.getAttribute('href');
+      img.alt = imgLink.textContent.trim() || '';
+      const p = document.createElement('p');
+      p.append(img);
+      imgLink.remove();
+      inner.insertAdjacentElement('afterbegin', p);
+    }
+  }
+  const pic = inner.querySelector('picture');
+  img = inner.querySelector('img');
+  if (img) {
+    if (!img.getAttribute('width')) img.setAttribute('width', IMG_W);
+    if (!img.getAttribute('height')) img.setAttribute('height', IMG_H);
+    if (!img.getAttribute('loading')) img.setAttribute('loading', 'lazy');
+    if (!img.hasAttribute('alt')) img.setAttribute('alt', '');
+    const holder = pic || img;
+    const box = h('div', { class: 'support-carousel-image' });
+    holder.replaceWith(box);
+    box.append(holder);
+  }
+}
+
+function decorateSlide(row, index) {
+  row.classList.add('support-carousel-slide');
+  row.setAttribute('role', 'group');
+  row.setAttribute('aria-roledescription', 'slide');
+  row.setAttribute('aria-label', `${index + 1}`);
+  const inner = row.querySelector(':scope > div') || row;
+  inner.classList.add('support-carousel-card');
+  decorateImage(inner);
+  const heading = inner.querySelector('h1, h2, h3, h4, h5, h6');
+  if (heading) heading.classList.add('support-carousel-title');
+  const cta = inner.querySelector('a');
+  if (cta) {
+    cta.classList.add('support-carousel-cta');
+    inner.append(cta);
+    cta.append(h('span', { class: 'support-carousel-arrow', 'aria-hidden': 'true', text: '→' }));
+  }
+  inner.querySelectorAll(':scope > p').forEach((p) => {
+    if (p.querySelector('img')) return;
+    if (!p.classList.contains('support-carousel-cta')) p.classList.add('support-carousel-desc');
+  });
+}
+
+export default async function init(el) {
+  const slides = [...el.querySelectorAll(':scope > div')];
+  slides.forEach(decorateSlide);
+
+  const track = h('div', { class: 'support-carousel-track', role: 'list' });
+  slides.forEach((s) => track.append(s));
+
+  const prev = h('button', { class: 'support-carousel-btn support-carousel-prev', type: 'button', 'aria-label': 'Previous' }, h('span', { 'aria-hidden': 'true', text: '‹' }));
+  const next = h('button', { class: 'support-carousel-btn support-carousel-next', type: 'button', 'aria-label': 'Next' }, h('span', { 'aria-hidden': 'true', text: '›' }));
+  const dots = h('div', { class: 'support-carousel-dots', role: 'tablist', 'aria-label': 'Choose slide' });
+
+  el.textContent = '';
+  const viewport = h('div', { class: 'support-carousel-viewport' }, track);
+  el.append(prev, viewport, next, dots);
+
+  // Dots — one per slide.
+  slides.forEach((s, i) => {
+    const dot = h('button', { class: 'support-carousel-dot', type: 'button', role: 'tab', 'aria-label': `Slide ${i + 1}` });
+    dot.addEventListener('click', () => {
+      s.scrollIntoView({ behavior: 'smooth', inline: 'start', block: 'nearest' });
+    });
+    dots.append(dot);
+  });
+
+  const page = () => {
+    const cardW = slides[0]?.offsetWidth || viewport.clientWidth;
+    return Math.max(1, Math.round(viewport.clientWidth / cardW));
+  };
+  const scrollByCards = (dir) => {
+    const step = (slides[0]?.offsetWidth || 300) * page();
+    track.scrollBy({ left: dir * step, behavior: 'smooth' });
+  };
+  prev.addEventListener('click', () => scrollByCards(-1));
+  next.addEventListener('click', () => scrollByCards(1));
+
+  // Update dot/button state on scroll.
+  const update = () => {
+    const { scrollLeft, scrollWidth, clientWidth } = track;
+    prev.disabled = scrollLeft <= 2;
+    next.disabled = scrollLeft + clientWidth >= scrollWidth - 2;
+    const active = Math.round(scrollLeft / (slides[0]?.offsetWidth || 1));
+    [...dots.children].forEach((d, i) => {
+      d.classList.toggle('is-active', i === active);
+      d.setAttribute('aria-selected', i === active ? 'true' : 'false');
+    });
+  };
+  track.addEventListener('scroll', () => window.requestAnimationFrame(update), { passive: true });
+  window.addEventListener('resize', update);
+  update();
+}
