+.support-cards .support-card-inner {
+  display: flex;
+  flex-direction: column;
+  width: 100%;
+}
+
+.support-cards .support-card-image {
+  /* Reserve 16:9 space to avoid layout shift while the image loads */
+  position: relative;
+  aspect-ratio: 16 / 9;
+  overflow: hidden;
+  background-color: light-dark(var(--color-gray-100), var(--color-gray-800));
+}
+
+.support-cards .support-card-image img,
+.support-cards .support-card-image picture {
+  width: 100%;
+  height: 100%;
+  object-fit: cover;
+  display: block;
+}
+
+.support-cards .support-card-title {
+  margin: 0;
+  padding: var(--spacing-l) var(--spacing-l) 0;
+  font-size: var(--heading-font-size-xs);
+  color: light-dark(var(--color-dark), var(--color-light));
+}
+
+.support-cards .support-card-desc {
+  margin: var(--spacing-s) 0 0;
+  padding: 0 var(--spacing-l);
+  font-size: var(--body-font-size-m);
+  line-height: var(--body-line-height);
+  color: light-dark(var(--color-gray-700), var(--color-gray-300));
+}
+
+.support-cards .support-card-cta {
+  margin-top: auto;
+  padding: var(--spacing-m) var(--spacing-l) var(--spacing-l);
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  color: var(--support-blue);
+  font-weight: 600;
+  text-decoration: none;
